# Orkestr Gateway — agent passerelle
PORT=4000
# Tokens d'accès / clés d'invitation (séparés par virgule). Génère-en un avec: npm run gen-token
GATEWAY_TOKENS=orkestr-dev-token-change-me
# Fichier registre des projets
PROJECTS_FILE=./config/projects.json
# Binaire OpenCode CLI (opencode). Si absent, la gateway bascule en SIMULATION documentée.
OPENCODE_BIN=opencode
# Timeout max d'exécution agent (ms)
AGENT_TIMEOUT_MS=600000
# Racines autorisées (optionnel, séparées par ;). Vide = seuls les chemins du registre sont autorisés.
ALLOWED_ROOTS=
